# Example Nginx site for a WM Supplies customer domain on the same VPS.
#
# Replace orders.example.co.uk with the real GoDaddy-hosted domain/subdomain.
# DNS should point that name to this VPS public IP with an A record.
#
# Current single-process launch:
# - Existing app process: 127.0.0.1:5000
# - Existing build/mount: /arcarna
# - Customer URL becomes: https://orders.example.co.uk/arcarna/
#
# Clean-root launch:
# - Add a second PM2 process: 127.0.0.1:5001
# - Build it with VITE_BASE_PATH= and APP_BASE_PATH=
# - Customer URL becomes: https://orders.example.co.uk/

server {
    listen 80;
    server_name orders.example.co.uk;

    client_max_body_size 25m;

    location = / {
        return 302 /arcarna/;
    }

    location /arcarna/ {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}

