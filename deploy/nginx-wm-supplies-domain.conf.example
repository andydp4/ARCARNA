# Example Nginx site for the WM Supplies customer website on the same VPS.
#
# DNS should point wmsupplies.com and www.wmsupplies.com to the website host.
# Arcana remains the backend/admin app at https://arcarna.viger.cloud.
#
# Customer website launch:
# - Website process: 127.0.0.1:5001
# - Build it with VITE_BASE_PATH= and APP_BASE_PATH=
# - Customer URL: https://wmsupplies.com/

server {
    listen 80;
    server_name wmsupplies.com www.wmsupplies.com;

    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:5001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}

