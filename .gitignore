# Rendered training-manual PDFs (regenerated from docs/training/sections/*.html)
docs/training/*.pdf

# New Astro brand fonts — licensed desktop files, embedded in exported PDFs only.
# Never commit/redistribute (arcarna Brand Bible, Book 06, Font licensing).
docs/training/fonts/*.otf

# Agent worktrees + local agent state. Ephemeral scratch (each worktree is a
# full repo copy) — never commit these. Shared project config is excepted
# below: the SessionStart hook must be committed or web sessions start with no
# database.
.claude/*
!.claude/hooks/
!.claude/settings.json
# Personal overrides stay local.
.claude/settings.local.json
