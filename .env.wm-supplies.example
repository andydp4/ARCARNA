# =============================================================================
# WM Supplies customer website production process
# =============================================================================
# Copy this to .env in the separate VPS folder used for wmsupplies.com.
# Do not commit the real .env file.
# =============================================================================

NODE_ENV=production
PORT=5001

# Use the same production database as Arcana so stock, products, approvals, and
# website orders are shared with the Arcana backend/admin app.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/DATABASE?sslmode=require

SESSION_SECRET=CHANGE_ME_session_secret_at_least_32_characters
SESSION_COOKIE_SECURE=1

# Website mode: serve only the WM Supplies customer routes at the site root.
WM_SUPPLIES_CUSTOMER_SITE=1
VITE_WM_SUPPLIES_CUSTOMER_SITE=1
VITE_APP_URL=https://wmsupplies.com
VITE_BASE_PATH=
APP_BASE_PATH=

# Arcana should run background workers. The website process serves customer
# traffic only, which avoids duplicate worker polling on the same database.
WORKERS_ENABLED=0

# Clerk must be the same Clerk application used for Arcana approvals unless you
# deliberately create a separate Clerk app and wire approval syncing later.
AUTH_PROVIDER=clerk
CLERK_SECRET_KEY=sk_live_CHANGE_ME
CLERK_PUBLISHABLE_KEY=pk_live_CHANGE_ME
VITE_AUTH_PROVIDER=clerk
VITE_CLERK_PUBLISHABLE_KEY=pk_live_CHANGE_ME
CLERK_ACCOUNTS_URL=https://accounts.viger.cloud
VITE_CLERK_ACCOUNTS_URL=https://accounts.viger.cloud

DEV_AUTH_BYPASS=0
PHASE2D_TEST=0

# Optional runtime/reporting keys can match production Arcana where needed.
# SENTRY_DSN=
# VITE_SENTRY_DSN=
# RESEND_API_KEY=
# RECEIPT_FROM_EMAIL=receipts@wmsupplies.com
# RECEIPT_SIGNING_SECRET=
